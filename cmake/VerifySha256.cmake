# cmake -DSUMS=<SHA256SUMS file> -P VerifySha256.cmake
# Portable equivalent of `shasum -a 256 -c SHA256SUMS`.
get_filename_component(dir "${SUMS}" DIRECTORY)
file(STRINGS "${SUMS}" lines)
set(count 0)
foreach(line IN LISTS lines)
  if(NOT line MATCHES "^([0-9a-f]+) [ *](.+)$")
    message(FATAL_ERROR "cannot parse line in ${SUMS}: ${line}")
  endif()
  set(expected "${CMAKE_MATCH_1}")
  set(name "${CMAKE_MATCH_2}")
  file(SHA256 "${dir}/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${name}: FAILED\n  expected ${expected}\n  actual   ${actual}")
  endif()
  message(STATUS "${name}: OK")
  math(EXPR count "${count} + 1")
endforeach()
if(count EQUAL 0)
  message(FATAL_ERROR "${SUMS} lists no files")
endif()
