# Writes OUTPUT, a header defining SHEWCHUK_BENCH_GIT_REVISION (a string) and
# SHEWCHUK_BENCH_GIT_DIRTY (0 or 1) for the checkout at SOURCE_DIR.
# OVERRIDE, if not empty, is used as the revision (for sources that are not a
# git checkout, such as the exported trees tools/compare_revs.py builds).
set(revision "unknown")
set(dirty 0)
if(OVERRIDE)
  set(revision "${OVERRIDE}")
else()
  find_package(Git QUIET)
  if(Git_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse HEAD
      OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE status)
    if(status EQUAL 0)
      set(revision "${head}")
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain
        OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(changes)
        set(dirty 1)
      endif()
    endif()
  endif()
endif()
set(content "// Generated by bench/GitRevision.cmake.
#define SHEWCHUK_BENCH_GIT_REVISION \"${revision}\"
#define SHEWCHUK_BENCH_GIT_DIRTY ${dirty}
")
set(previous "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
endif()
if(NOT content STREQUAL previous)
  file(WRITE "${OUTPUT}" "${content}")
endif()
